{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --target=es2022 --external:cloudflare:sockets --outfile=dist/_worker.js",
    "preview": "astro preview",
    "preview:pages": "npm run build && npx --yes wrangler pages dev dist",
    "deploy": "npm run build && npx --yes wrangler pages deploy dist",
    "zip": "npm run build && cd dist && rm -f ../dist.zip && zip -r -X ../dist.zip . -x '.DS_Store' '__MACOSX/*'",
    "astro": "astro",
    "typecheck": "tsc -p worker"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.3",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.3"
  }
}
